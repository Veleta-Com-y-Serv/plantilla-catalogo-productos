---
import Base from '../layouts/Base.astro';
import { buscarSeccion } from '../data/site';
const productos = buscarSeccion('productos');
---

<Base titulo="Página no encontrada">
  <section class="rejilla-tecnica border-b border-[var(--c-borde-fuerte)]">
    <div class="contenedor py-20 md:py-28">
      <div class="panel max-w-2xl border-t-4 border-t-acento p-6 sm:p-10">
        <p class="antetitulo">Error 404</p>
        <h1 class="titulo-seccion">Esta página no existe</h1>
        <p class="mt-4 opacity-85">Puede que el enlace esté mal o que el producto ya no esté en el catálogo.</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a class="btn" href="/">Volver al inicio</a>
          {productos && <a class="btn-sec text-primario" href={`/#${productos.id}`}>{productos.s.antetitulo || productos.s.titulo}</a>}
        </div>
      </div>
    </div>
  </section>
</Base>
