---
// Ejemplo de página adicional: usa el layout base y se enlaza desde el pie (o desde site.yaml → menu).
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
const c = site.contacto;
---

<Base titulo="Aviso legal y privacidad" descripcion={`Aviso legal y política de privacidad de ${site.nombre}.`}>
  <div class="contenedor py-12 md:py-16">
    <p class="antetitulo">{site.nombre}</p>
    <h1 class="titulo-seccion">Aviso legal y privacidad</h1>
    <article class="panel texto-largo mt-8 max-w-3xl p-6 sm:p-10">
      <h2 class="mt-0 border-b border-[var(--c-borde)] pb-2 text-primario">Quiénes somos</h2>
      <p>
        Esta web pertenece a {site.nombre}{c.direccion && `, con domicilio en ${c.direccion}`}. Puedes escribirnos a {
          c.email || 'nuestro correo de contacto'
        }{c.telefono && ` o llamarnos al ${c.telefono}`}.
      </p>
      <h2 class="border-b border-[var(--c-borde)] pb-2 text-primario">Qué datos tratamos</h2>
      <p>
        Solo los que nos envías al escribirnos: nombre, empresa, forma de contacto y tu mensaje. Los usamos para
        responderte y preparar tu presupuesto. No los cedemos a nadie salvo obligación legal.
      </p>
      <h2 class="border-b border-[var(--c-borde)] pb-2 text-primario">Cuánto tiempo los guardamos</h2>
      <p>El necesario para atender tu consulta y, después, el que marque la ley.</p>
      <h2 class="border-b border-[var(--c-borde)] pb-2 text-primario">Tus derechos</h2>
      <p>
        Puedes pedir acceso, rectificación o supresión de tus datos escribiendo a {c.email || 'nuestro correo'}. También
        puedes reclamar ante la Agencia Española de Protección de Datos (aepd.es).
      </p>
      <h2 class="border-b border-[var(--c-borde)] pb-2 text-primario">Cookies</h2>
      <p>Esta web no usa cookies de seguimiento.</p>
      <p class="mt-10"><a class="btn" href="/">Volver al inicio</a></p>
    </article>
  </div>
</Base>
