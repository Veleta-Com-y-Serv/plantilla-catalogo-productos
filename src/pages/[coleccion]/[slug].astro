---
// Ficha de un producto con `detalle` (src/lib/paginas.ts, listas de src/data/fichas.ts): /productos/<slug>/.
// Diseño «hoja técnica»: banda de rejilla con migas y cabecera partida (foto 4:3 sobre blanco con borde marcado,
// referencia en monoespaciada, estado, precio y botones de presupuesto y WhatsApp); cuerpo con el `detalle`, la
// tabla de características y una caja acero con llamada a pedir presupuesto; fotos (`imagenes`) y otros productos.
import Base from '../../layouts/Base.astro';
import Imagen from '../../components/ui/Imagen.astro';
import Icono from '../../components/ui/Icono.astro';
import Titular from '../../components/ui/Titular.astro';
import { buscarSeccion, especificaciones, site, tel, whatsapp } from '../../data/site';
import { fichas, relacionadas, resumen } from '../../lib/paginas';
import type { Ficha } from '../../lib/paginas';
import { altGaleria, jsonLdFicha, jsonLdMigas, urlBase } from '../../lib/seo';

export function getStaticPaths() {
  return fichas().map((f) => ({ params: { coleccion: f.def.ruta, slug: f.slug }, props: { f } }));
}

interface Props { f: Ficha }
const { f } = Astro.props;
const base = urlBase(Astro.site);
const nombreSeccion = String(f.seccion.antetitulo || f.seccion.titulo || f.def.nombre).trim();
const migas = [
  { nombre: 'Inicio', ruta: '/' },
  { nombre: nombreSeccion, ruta: `/#${f.idSeccion}` },
  { nombre: f.titulo, ruta: f.url },
];
const c = site.contacto;
const contacto = buscarSeccion('contacto');
const pedir = contacto ? `/#${contacto.id}` : site.boton_cabecera?.url || '/#contacto';
const textoPedir = site.boton_cabecera?.texto || 'Pedir presupuesto';
const wa = whatsapp(c.whatsapp, `Hola, quiero información sobre ${f.titulo}`);
const el = f.elemento as Record<string, unknown>;
const ref = String(el.ref ?? '').trim();
const estado = String(el.estado ?? '').trim();
const specs = especificaciones(String(el.caracteristicas ?? ''));
const datos = f.datos.filter((d) => !['precio', 'ref', 'estado', 'categoria', 'caracteristicas'].includes(d.clave));
const conPrecio = !!f.precio && !/^consultar$/i.test(f.precio.trim());
const otras = relacionadas(f, 3);
const descripcion = resumen(f.texto || f.detalle[0] || '');
---

<Base titulo={f.titulo} descripcion={descripcion} imagen={f.imagen} ld={[jsonLdMigas(base, migas), jsonLdFicha(base, f)]}>
  <section class="ficha-cabeza rejilla-tecnica border-b-2 border-[var(--c-primario)]">
    <div class="contenedor">
      <nav aria-label="Migas de pan" class="migas">
        <ol>
          {migas.map((m, i) => (
            <li>{i < migas.length - 1 ? <a href={m.ruta}>{m.nombre}</a> : <span aria-current="page">{m.nombre}</span>}</li>
          ))}
        </ol>
      </nav>
      <div class:list={['ficha-hero', { 'ficha-hero--sin-foto': !f.imagen }]}>
        <div class="ficha-hero-texto">
          <p class="antetitulo">{f.categoria || f.def.nombre}</p>
          <h1 class="titulo-seccion">{f.titulo}</h1>
          <p class="ficha-meta">
            {ref && <span class="mono ficha-ref">Ref. {ref}</span>}
            {estado && <span class:list={['estado', /^nuevo$/i.test(estado) && 'estado--nuevo']}>{estado}</span>}
          </p>
          {f.texto && <p class="titular-texto">{f.texto}</p>}
          {f.precio && <p class="ficha-precio">{f.precio}</p>}
          <div class="ficha-botones">
            <a class="btn" href={pedir}>{textoPedir}</a>
            {wa && <a class="btn-sec text-primario" href={wa} target="_blank" rel="noopener"><Icono nombre="whatsapp" tam={18} /> WhatsApp</a>}
          </div>
        </div>
        {f.imagen ? (
          <div class="ficha-foto panel">
            <Imagen src={f.imagen} alt={f.titulo} ancho={1200} alto={900} prioridad class="h-full w-full object-contain p-4" />
          </div>
        ) : (
          <div class="ficha-icono panel" aria-hidden="true"><Icono nombre={f.icono || 'caja'} tam={96} /></div>
        )}
      </div>
    </div>
  </section>

  <section class="seccion">
    <div class="contenedor ficha-cuerpo">
      <article class="texto-largo ficha-detalle">
        {f.detalle.map((p) => <p>{p}</p>)}
      </article>
      <aside class="ficha-lado">
        {(specs.length > 0 || datos.length > 0 || conPrecio) && (
          <div class="ficha-datos panel">
            <h2 class="ficha-lado-titulo">Ficha técnica</h2>
            <dl class="tabla-specs">
              {ref && (<><dt>Referencia</dt><dd class="mono">{ref}</dd></>)}
              {specs.map((e) => e.clave ? (<><dt>{e.clave}</dt><dd>{e.valor}</dd></>) : (<dd class="sola">{e.valor}</dd>))}
              {datos.map((d) => (<><dt>{d.etiqueta}</dt><dd>{d.valor}</dd></>))}
              {conPrecio && (<><dt>Precio</dt><dd>{f.precio}</dd></>)}
            </dl>
          </div>
        )}
        <div class="ficha-caja">
          <p class="ficha-caja-titulo">¿Lo necesitas para tu taller?</p>
          <p>Te enviamos presupuesto cerrado y te decimos si está en almacén.</p>
          <a class="btn" href={pedir}>{textoPedir}</a>
          {c.telefono && <a class="ficha-tel" href={tel(c.telefono)}><Icono nombre="telefono" tam={18} /> {c.telefono}</a>}
        </div>
      </aside>
    </div>
  </section>

  {f.imagenes.length > 0 && (
    <section class="seccion border-y border-[var(--c-borde-fuerte)] bg-[color-mix(in_srgb,var(--c-primario)_4%,var(--c-fondo))]" aria-label={`Fotos de ${f.titulo}`}>
      <div class="contenedor">
        <ul class="ficha-galeria">
          {f.imagenes.map((src, i) => (
            <li class="panel"><Imagen src={src} alt={`${f.titulo}: ${altGaleria(i).toLowerCase()}`} ancho={800} alto={600} class="h-full w-full object-contain p-3" /></li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {otras.length > 0 && (
    <section class="seccion border-t border-[var(--c-borde-fuerte)]">
      <div class="contenedor">
        <Titular antetitulo={nombreSeccion} titulo="Otros productos del catálogo" />
        <ul class="ficha-otras">
          {otras.map((o) => (
            <li class="ficha-otra panel">
              <div class="ficha-otra-foto"><Imagen src={o.imagen || '/placeholders/producto.svg'} alt="" ancho={800} alto={600} respaldo="/placeholders/producto.svg" class="aspect-[4/3] w-full object-contain p-3" /></div>
              <div class="ficha-otra-cuerpo">
                {o.categoria && <p class="mono ficha-otra-cat">{o.categoria}</p>}
                <h3><a href={o.url} class="ficha-otra-enlace">{o.titulo}</a></h3>
                {o.texto && <p>{o.texto}</p>}
                <p class="ficha-otra-pie">
                  {o.precio && !/^consultar$/i.test(o.precio.trim()) && <span class="ficha-precio-sm">{o.precio}</span>}
                  <span class="ficha-otra-ver" aria-hidden="true">Ver ficha <Icono nombre="flecha" tam={16} /></span>
                </p>
              </div>
            </li>
          ))}
        </ul>
        <p class="mt-8"><a class="btn-sec text-primario" href={`/#${f.idSeccion}`}>Ver todo el catálogo</a></p>
      </div>
    </section>
  )}
</Base>

<style>
  .ficha-cabeza { padding-block: clamp(1rem, 3vw, 2rem) clamp(2.5rem, 6vw, 4.5rem); }
  .migas ol { display: flex; flex-wrap: wrap; gap: .25rem .5rem; font-size: .85rem; font-weight: 600; font-family: var(--fuente-mono); }
  .migas li { display: inline-flex; align-items: center; gap: .5rem; min-width: 0; }
  .migas li + li::before { content: "/"; opacity: .5; }
  .migas a { color: var(--c-primario); text-decoration: none; min-height: 2.75rem; display: inline-flex; align-items: center; }
  .migas a:hover { text-decoration: underline; }
  .migas [aria-current] { opacity: .7; overflow-wrap: anywhere; }
  .ficha-hero { display: grid; gap: 2rem; margin-top: 1rem; align-items: center; }
  .ficha-hero-texto .titulo-seccion { font-size: clamp(1.9rem, 5vw, 3.1rem); overflow-wrap: anywhere; }
  .ficha-meta { display: flex; flex-wrap: wrap; align-items: center; gap: .6rem 1rem; margin-top: .9rem; }
  .ficha-ref { font-size: .9rem; font-weight: 700; color: var(--c-acento-texto); }
  .ficha-precio { font-size: 1.6rem; font-weight: 800; color: var(--c-primario); margin-top: 1.25rem; }
  .ficha-precio-sm { font-weight: 800; color: var(--c-primario); }
  .ficha-botones { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 1.5rem; }
  .ficha-botones a { display: inline-flex; align-items: center; justify-content: center; gap: .5rem; min-height: 2.75rem; padding-inline: 1.25rem; font-weight: 700; text-decoration: none; }
  .ficha-foto, .ficha-icono { aspect-ratio: 4 / 3; background: #fff; overflow: hidden; }
  .ficha-icono { display: grid; place-items: center; color: var(--c-primario); }
  .ficha-cuerpo { display: grid; gap: 2.5rem; }
  .ficha-detalle { max-width: 44rem; font-size: 1.05rem; }
  .ficha-detalle p + p { margin-top: 1.1rem; }
  .ficha-detalle p:first-child { font-size: 1.15rem; font-weight: 500; }
  .ficha-lado { display: grid; gap: 1.5rem; align-content: start; }
  .ficha-lado-titulo { font-family: var(--fuente-mono); font-size: .8rem; text-transform: uppercase; letter-spacing: .06em; color: var(--c-acento-texto); margin-bottom: .8rem; }
  .ficha-datos { padding: 1.25rem; }
  .ficha-datos .tabla-specs { font-size: .9rem; }
  .ficha-caja { display: grid; gap: .8rem; padding: 1.5rem; background: var(--c-oscuro); color: rgb(255 255 255 / .88); border-top: 4px solid var(--c-acento); border-radius: var(--radio); }
  .ficha-caja-titulo { font-size: 1.3rem; font-weight: 800; line-height: 1.2; color: #fff; }
  .ficha-caja .btn { display: inline-flex; align-items: center; justify-content: center; min-height: 2.75rem; font-weight: 700; text-decoration: none; }
  .ficha-tel { display: inline-flex; align-items: center; gap: .5rem; min-height: 2.75rem; font-weight: 700; color: #fff; text-decoration: none; }
  .ficha-galeria { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr)); }
  .ficha-galeria li { aspect-ratio: 4 / 3; overflow: hidden; background: #fff; }
  .ficha-otras { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr)); }
  .ficha-otra { position: relative; display: flex; flex-direction: column; overflow: hidden; }
  .ficha-otra-foto { background: #fff; border-bottom: 1px solid var(--c-borde); }
  .ficha-otra-cuerpo { display: flex; flex: 1; flex-direction: column; gap: .4rem; padding: 1rem; }
  .ficha-otra-cat { font-size: .72rem; font-weight: 600; text-transform: uppercase; color: var(--c-acento-texto); }
  .ficha-otra h3 { font-size: 1.05rem; color: var(--c-primario); overflow-wrap: anywhere; }
  .ficha-otra-enlace { text-decoration: none; color: inherit; }
  .ficha-otra-enlace::after { content: ""; position: absolute; inset: 0; }
  .ficha-otra-enlace:focus-visible { outline: none; }
  .ficha-otra:has(.ficha-otra-enlace:focus-visible) { outline: 2px solid var(--c-acento); outline-offset: 2px; }
  .ficha-otra-cuerpo p { font-size: .9rem; opacity: .8; }
  .ficha-otra-pie { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-top: auto; padding-top: .5rem; opacity: 1 !important; }
  .ficha-otra-ver { display: inline-flex; align-items: center; gap: .3rem; font-weight: 700; color: var(--c-primario); }
  @media (min-width: 1024px) {
    .ficha-hero { grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: 3.5rem; }
    .ficha-cuerpo { grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: 4rem; align-items: start; }
    .ficha-lado { position: sticky; top: 2rem; }
  }
</style>
