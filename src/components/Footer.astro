---
// Pie técnico con columnas: marca y redes, categorías (de la sección `categorias`), empresa (site.yaml → menu) y contacto.
// «Web creada con NoExpertise» se muestra si site.yaml → marca_pie no es false.
import { site, tel, mapa, buscarSeccion, clave } from '../data/site';
import Icono from './ui/Icono.astro';
interface Props { variante?: string }
const { variante = 'tecnico' } = Astro.props;
const c = site.contacto;
const redes = Object.entries(site.redes).filter(([, url]) => url);
const anio = new Date().getFullYear();
const cats = buscarSeccion('categorias');
const productos = buscarSeccion('productos');
const destino = productos ? `/#${productos.id}` : cats ? `/#${cats.id}` : '/';
const categorias = cats ? cats.s.items.filter((i) => i.titulo).slice(0, 10) : [];
---

<footer class={`pie pie--${variante}`}>
  <div class="contenedor pie-rejilla">
    <div class="pie-marca">
      <p class="pie-nombre">{site.nombre}</p>
      {site.eslogan && <p class="pie-eslogan">{site.eslogan}</p>}
      {
        redes.length > 0 && (
          <ul class="pie-redes">
            {redes.map(([red, url]) => (
              <li>
                <a href={url} rel="noopener" target="_blank" aria-label={red}>
                  <Icono nombre={red} tam={20} />
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
    {
      categorias.length > 0 && (
        <div>
          <p class="pie-titulo">{cats?.s.antetitulo || cats?.s.titulo}</p>
          <ul class="pie-lista">
            {categorias.map((cat) => <li><a href={cat.url || destino} data-ir-categoria={cat.url ? undefined : clave(cat.titulo)}>{cat.titulo}</a></li>)}
          </ul>
        </div>
      )
    }
    {
      site.menu.length > 0 && (
        <div>
          <p class="pie-titulo">{site.nombre}</p>
          <ul class="pie-lista">
            {site.menu.map((e) => <li><a href={e.url}>{e.texto}</a></li>)}
          </ul>
        </div>
      )
    }
    <div>
      <p class="pie-titulo">Contacto</p>
      <ul class="pie-lista">
        {c.telefono && <li><a href={tel(c.telefono)} class="mono text-lg font-bold text-white">{c.telefono}</a></li>}
        {c.email && <li><a href={`mailto:${c.email}`} class="break-words">{c.email}</a></li>}
        {c.direccion && <li><a href={mapa(c.direccion)} rel="noopener" target="_blank">{c.direccion}</a></li>}
        {c.horario && <li class="text-sm opacity-80">{c.horario}</li>}
      </ul>
    </div>
  </div>
  <div class="contenedor pie-legal">
    <span>© {anio} {site.nombre}</span>
    <a href="/aviso-legal">Aviso legal y privacidad</a>
    {
      site.marca_pie && (
        <span class="pie-noexpertise">
          Web creada con <a href="https://noexpertise.com" rel="noopener">NoExpertise</a>
        </span>
      )
    }
  </div>
</footer>
